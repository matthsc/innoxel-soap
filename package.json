{
  "name": "innoxel-soap",
  "version": "2.0.0",
  "description": "innoxel master soap api client",
  "keywords": [
    "innoxel",
    "api",
    "soap"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/matthsc/innoxel-soap"
  },
  "bugs": "https://github.com/matthsc/innoxel-soap/issues",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check",
    "check": "node --run check:tsc && node --run check:exports && node --run lint && node --run test",
    "check:tsc": "tsc --noEmit",
    "check:exports": "attw --pack .",
    "format": "biome check --write",
    "build": "tsdown",
    "prepare": "node --run build",
    "prepublishOnly": "node --run check",
    "preversion": "node --run check",
    "release": "dotenv run -- release-it --only-version",
    "version": "node --run format && git add -A src"
  },
  "author": "Matthias Schwende (matthsc@gmx.net)",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.12.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.8",
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.10",
    "msw": "^3.0.6",
    "release-it": "^21.1.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "fflate": "0.8.2"
  },
  "files": [
    "dist/**/*"
  ],
  "release-it": {
    "github": {
      "release": true
    }
  }
}
